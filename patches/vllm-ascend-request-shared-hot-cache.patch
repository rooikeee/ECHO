+++ b/vllm-ascend/vllm_ascend/distributed/kv_transfer/sparse_kv_offload/shared_hot_layout.py
@@ -0,0 +1,46 @@
+"""Opt-in request-owned resident cache with compact, private graph scratch rows."""
+from dataclasses import dataclass
+import numpy as np
+
+DUMMY_HOT_TOKENS = 2048
+
+@dataclass(frozen=True)
+class SharedHotLayout:
+    request_capacity: int
+    logical_capacity: int
+    hot_tokens: int
+    block_size: int
+
+    @property
+    def stride(self):
+        return self.hot_tokens + 2 * self.block_size
+
+    @property
+    def dummy_stride(self):
+        return DUMMY_HOT_TOKENS + 2 * self.block_size
+
+    @property
+    def allocation_rows(self):
+        tokens = self.request_capacity * self.stride + self.logical_capacity * self.dummy_stride
+        return (tokens + self.stride - 1) // self.stride
+
+    def token_bases(self, slots):
+        slots = np.asarray(slots, dtype=np.int64)
+        real = slots < self.logical_capacity
+        if np.any(slots < 0) or np.any(slots >= 2 * self.logical_capacity):
+            raise ValueError('Invalid shared-cache logical slot')
+        if np.any(real & (slots >= self.request_capacity)):
+            raise ValueError('Shared resident cache exhausted; scheduler admission must wait')
+        return np.where(real, slots * self.stride,
+                        self.request_capacity * self.stride + (slots-self.logical_capacity)*self.dummy_stride)
+
+
+def shared_hot_layout(config, hot_tokens, block_size):
+    transfer = getattr(config, 'kv_transfer_config', None)
+    extra = (getattr(transfer, 'kv_connector_extra_config', None) or {}).get('echo_shared_hot_cache')
+    if extra is None:
+        return None
+    capacity = int(extra['request_capacity'])
+    if not 0 < capacity <= config.scheduler_config.max_num_seqs:
+        raise ValueError('Invalid memory-derived resident request capacity')
+    return SharedHotLayout(capacity, config.scheduler_config.max_num_seqs + 2, hot_tokens, block_size)
