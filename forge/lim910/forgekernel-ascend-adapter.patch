@@ -0,0 +1,65 @@
+import json
+import subprocess
+
+from forgekernel import ascend
+from forgekernel.ascend import assess, candidate_allowed
+
+
+def test_keep_requires_correctness_and_device_gain():
+    def payload(ok, time):
+        return "=== JSON ===\n" + json.dumps(
+            {"correctness": {"pass": ok}, "performance": {"device_median_ms": time}}
+        )
+
+    assert assess(payload(True, 3.0), 4.0, 0.015)[0]
+    assert not assess(payload(False, 1.0), 4.0, 0.015)[0]
+    assert not assess(payload(True, 3.99), 4.0, 0.015)[0]
+    assert not assess(payload(True, None), 4.0, 0.015)[0]
+    assert not assess(payload(True, 0), 4.0, 0.015)[0]
+    assert not assess(payload(True, -1), 4.0, 0.015)[0]
+
+
+def test_edit_scope_rejects_empty_or_validator_changes():
+    assert candidate_allowed({"kernel.h"}, {"kernel.h", "consume.py"})
+    assert not candidate_allowed(set(), {"kernel.h"})
+    assert not candidate_allowed({"kernel.h", "eval.py"}, {"kernel.h"})
+
+
+def test_rejected_candidate_restores_source(tmp_path, monkeypatch):
+    subprocess.run(["git", "init", "-q", str(tmp_path)], check=True)
+    (tmp_path / "kernel.h").write_text("original\n")
+    (tmp_path / "contract.md").write_text("Frozen oracle; full graph timing.")
+    baseline = {"correctness": {"pass": True}, "performance": {"device_median_ms": 4.0}}
+    (tmp_path / "baseline.json").write_text(json.dumps(baseline))
+    config = {
+        "workspace": str(tmp_path),
+        "editable_files": ["kernel.h"],
+        "description": "contract.md",
+        "baseline_result": "baseline.json",
+        "rounds": 1,
+    }
+    (tmp_path / "task.json").write_text(json.dumps(config))
+    output = tmp_path / "run"
+
+    def fake_agent(workspace, output_dir, role, prompt, timeout):
+        if role == "student":
+            (workspace / "kernel.h").write_text("incorrect\n")
+            return "decision_id: D1\nchange: test edit\nfiles_touched: kernel.h"
+        return "Try a candidate."
+
+    monkeypatch.setattr(ascend, "agent", fake_agent)
+    monkeypatch.setattr(
+        ascend,
+        "evaluate",
+        lambda *args: json.dumps(
+            {"correctness": {"pass": False}, "performance": {"device_median_ms": 1.0}}
+        ),
+    )
+    assert ascend.run(tmp_path / "task.json", output) == 0
+    assert (tmp_path / "kernel.h").read_text() == "original\n"
+    rows = [
+        json.loads(row) for row in (output / "status.jsonl").read_text().splitlines()
+    ]
+    assert rows[-1]["verdict"] == "REVERT"
+    assert rows[-1]["metric_before"] == 4.0
+    assert json.loads((output / "summary.json").read_text())["best_prefetch_ms"] == 4.0
